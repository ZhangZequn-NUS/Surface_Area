      &SPHERE_SAMPLING
        AUTO_VDW_RADII_TABLE CAMBRIDGE #vdW radii type. This is default. Can also be UFF
        AUTO_RMIN_SCALE 1.0 #Scaled factor of vdW radii determining the inner boundary of sampling
        AUTO_RMAX_SCALE 2.0 #Scaled factor of vdW radii determining the outer boundary of sampling
      &END SPHERE_SAMPLING
      #Uncomment following lines can use slab sampling of fitting points
      #&SLAB_SAMPLING #The fitting points will sampled above a slab
      #  RANGE 2.0 4.0
      #  LENGTH 3.0
      #  ATOM_LIST 1..32 #List of considered atoms
      #  SURF_DIRECTION Z #What above the surface means. Can also be e.g. -Z, X, Z...
      #&END SLAB_SAMPLING
      &PRINT
        &COORD_FIT_POINTS
        &END COORD_FIT_POINTS
        &RESP_CHARGES_TO_FILE
        &END RESP_CHARGES_TO_FILE
      &END PRINT
    &END RESP
  &END PROPERTIES
&END FORCE_EVAL
